DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. Without it, the map uses OpenStreetMap tiles, which need no key.
# Create a key at https://console.cloud.google.com/ and enable Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional. Without it, the in-app assistant answers from the built-in advisor,
# which still reads live services, OpenStreetMap shops, and marketplace listings.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
